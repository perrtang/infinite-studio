{
  // Draft only. This replaces the existing gateway script; verify the active
  // custom-domain binding and rollback before using a production deploy.
  "name": "infinite-studio-gateway",
  "main": "drive-worker-entry.js",
  // Match the existing gateway runtime rather than silently downgrading it.
  "compatibility_date": "2026-10-19",
  "durable_objects": {
    "bindings": [{ "name": "DRIVE_GRANTS", "class_name": "DriveGrant" }]
  },
  "migrations": [{ "tag": "drive-grants-v1", "new_sqlite_classes": ["DriveGrant"] }]
}
